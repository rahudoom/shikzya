# Resend API key — used by /api/demo to email demo requests.
# Create one at https://resend.com → API Keys
RESEND_API_KEY=

# Where demo-request emails are delivered.
RESEND_TO=
# Verified "from" sender. During testing you can use onboarding@resend.dev;
# in production set a verified domain sender, e.g. demo@shikzya.com
RESEND_FROM=ShikZya Website <onboarding@resend.dev>
